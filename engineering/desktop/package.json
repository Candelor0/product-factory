{
  "name": "product-factory-desktop",
  "version": "0.15.0",
  "private": true,
  "description": "产品工厂桌面工作台",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "format": "prettier --write src tests scripts templates *.json *.ts index.html",
    "format:check": "prettier --check src tests scripts templates *.json *.ts index.html",
    "dev": "node scripts/dev.mjs",
    "preview:ui": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "test:plan": "node scripts/plan-smoke.mjs",
    "test:visual": "node scripts/visual-smoke.mjs",
    "test:source": "node scripts/source-smoke.mjs",
    "test:coding": "node scripts/coding-smoke.mjs",
    "test:build": "node scripts/build-smoke.mjs",
    "test:repair": "node scripts/repair-smoke.mjs",
    "test:recovery": "node scripts/recovery-smoke.mjs",
    "test:recovery-process": "node scripts/recovery-process-smoke.mjs",
    "test:runtime-feedback": "node scripts/runtime-feedback-smoke.mjs",
    "test:runtime-preview": "node scripts/runtime-preview-smoke.mjs",
    "test:app-data": "node scripts/app-data-smoke.mjs",
    "test:app-data-preview": "node scripts/app-data-preview-smoke.mjs",
    "test:export": "node scripts/export-smoke.mjs",
    "test:app-ai-preview": "node scripts/app-ai-preview-smoke.mjs",
    "test:app-ai": "node scripts/app-ai-smoke.mjs",
    "test:data-backup": "node scripts/data-backup-smoke.mjs",
    "test:data-migration": "node scripts/data-migration-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "acorn": "8.18.0",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
